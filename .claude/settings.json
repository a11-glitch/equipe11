{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(php *)",
      "Bash(outils/php/php.exe *)",
      "Bash(uname *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git remote get-url*)",
      "Bash(git switch -c equipe-*)",
      "Bash(git checkout -b equipe-*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin equipe-*)",
      "Bash(git push origin equipe-*)",
      "Bash(git switch main)",
      "Bash(git pull*)",
      "Bash(rm data/mantis.sqlite)",
      "Bash(bash outils/pr.sh *)",
      "Bash(git ls-remote*)",
      "Bash(git config user.*)",
      "Bash(git branch -m equipe-*)",
      "Bash(git check-ref-format*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-main.sh\""
          }
        ]
      }
    ]
  }
}
